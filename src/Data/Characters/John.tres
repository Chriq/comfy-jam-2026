[sub_resource type="Resource" id="Resource_8rrkb"]
script = ExtResource("2_e8vyf")
greeting = PackedStringArray("G’day, mate! A fine morning, innit?", "The name’s Johnathan Davis, and I have a special request that’ll knock yer thongs off!", "…No! Not that kind!", "Could you please prepare a")
response = PackedStringArray("Oi mate, that’s bloody good, innit?", "It’s just what I needed, a good kick in the arse to start the day!", "I’ve got a long day of networking ahead, actually. I’m a musician trying to make it in the games industry.", "I’ll be chatting up all the big shots in town. Wish me luck!")
drink = ExtResource("2_dbcih")

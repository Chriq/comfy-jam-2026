morningGreeting = PackedStringArray("G’day, mate! A fine morning, innit?", "The name’s Johnathan Davis, and I have a special request that’ll knock yer thongs off!", "…No! Not that kind!", "Could you please prepare a")
morningResponse = PackedStringArray("Oi mate, that’s bloody good, innit?", "It’s just what I needed, a good kick in the arse to start the day!", "I’ve got a long day of networking ahead, actually. I’m a musician trying to make it in the games industry.", "I’ll be chatting up all the big shots in town. Wish me luck!")
afternoonGreeting = PackedStringArray("This beach is going off like a frog in a sock! I could use a refresher in this sun.", "I\'ll have a")
afternoonResponse = PackedStringArray("Noice! It’s a good midday pick-me-up.", "Been having a rough go at it, mate. The suits are rather stiff, aren’t they?", "You’d think they’d lighten up on the beach knocking back a couple of coldie’s, but it’s still pretty brutal.", "I dunno, I’ll keep at it, but I might just enjoy the sights for a while. Thanks for the drink, mate.")
eveningGreeting = PackedStringArray("Hey, ya c***!", "[i]He does not, in fact, realize that word is wildly inappropriate in this context.[/i]", "Guess who just landed the music composer gig for the next Hitman’s Credo franchise! ", "It’ll be set in Ancient Greece, but I think I’ll actually go for a more upbeat, modern sound, just to spice it up!", "How about we celebrate with a")
eveningResponse = PackedStringArray("I appreciate your listening ear today. It\'s tough being a musician out there, but a little support, and a little sass, go a long way!")

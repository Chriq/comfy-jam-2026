[sub_resource type="Resource" id="Resource_25dnk"]
script = ExtResource("2_e8vyf")
greeting = PackedStringArray("Winding down? Who’s winding down!? The night is young! I want …")
response = PackedStringArray("It’s funny, talking to you, I realized no one’s ever really asked what I wanted before.", "I always just kind of.. Went along with whatever everyone said was best.", "But I just can’t do that anymore.", " I’m gonna head in early, actually, think about some things.", "Thanks… for asking what I wanted. I know it’s your job but, it helped.")
drink = ExtResource("4_25dnk")

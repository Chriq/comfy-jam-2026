[sub_resource type="Resource" id="Resource_8rrkb"]
script = ExtResource("2_e8vyf")
greeting = PackedStringArray("Heyyyy! I hope you make good drinks! If you wanna drink all day, you have to start early, so that’s what I’m doing!", "My name’s Becka. What do you recommend?", "Oh, you want to know what I want? … well… I guess, can you make …?")
response = PackedStringArray("OMG this is sooo gooood! This is my last Spring Break… ever… so I wanna do it right! Thanks!")
drink = ExtResource("2_m5lid")

[sub_resource type="Resource" id="Resource_m5lid"]
script = ExtResource("2_e8vyf")
greeting = PackedStringArray("I’m baaaack! You made it really good last time, can you make me another one? But this time…")
response = PackedStringArray("Even better than last time, thanks!", "Am I excited to graduate?", "… I don’t know, I try not to think about it. I’m just doing what I have to and trying to have some fun while I can.", "Gotta make my parents proud though…")
drink = ExtResource("3_8rrkb")
